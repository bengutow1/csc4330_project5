{
  "expo": {
    "name": "Fries in the Bag",
    "slug": "fries-in-the-bag",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cadenlund.friesinthebag"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.cadenlund.friesinthebag"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "backgroundColor": "#FBF8F4",
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-image",
      "expo-font",
      "expo-system-ui",
      [
        "expo-camera",
        {
          "cameraPermission": "Fries in the Bag uses the camera to judge your fridge and check your plates.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Fries in the Bag uses your location to find food near you. It is never stored.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "motionUsagePermission": false
        }
      ]
    ],
    "scheme": "friesinthebag",
    "experiments": {
      "typedRoutes": true
    }
  }
}
