# Every environment variable the API reads. The moon tasks already set the local values
# (apps/api/moon.yml), so nothing here is needed to develop; this is the list a deployment fills
# in. Never commit a filled-in copy.

# Required. The Postgres the API serves from. Locally, the database from docker/compose.yml.
DATABASE_URL=postgres://fries:fries@localhost:5432/fries?sslmode=disable
# Optional. The port the API listens on. Unset is 8080.
PORT=
# Optional. "development" or "local" allows what only a laptop may do, such as serving the vendor
# mocks. Unset or anything else runs hardened, like production.
APP_ENV=

# The places provider's key. Empty serves the places mock, which only local development may.
PLACES_API_KEY=
# Optional. "closed" closes every mock spot, for the "Even the fries are closed." screen. Unset
# serves the usual mock spots.
PLACES_MOCK=

# Optional. "text" for readable lines; anything else, or unset, is JSON.
LOG_FORMAT=text
# Optional. "debug" adds debug lines.
LOG_LEVEL=
# Set by the image build to the git sha. Unset logs as "dev".
APP_VERSION=
