moon = "2.4.2"

"npm:czg" = "1"
node = "24"
npm = "bundled"
pnpm = "10.33"
go = "1.26.4"

"cargo:cocogitto" = "6"
rust = "stable"

buf = "1.71"
gitleaks = "8"
golangci-lint = "2"
goose = "3.28"
infisical = "0.43"

[plugins]
buf = "file://./prototools/plugins/buf.toml"
gitleaks = "file://./prototools/plugins/gitleaks.toml"
golangci-lint = "https://raw.githubusercontent.com/b4nst/proto-plugins/refs/heads/main/toml/golangci-lint.toml"
goose = "file://./prototools/plugins/goose.toml"
infisical = "file://./prototools/plugins/infisical.toml"

[settings]
detect-strategy = "prefer-prototools"
auto-install = true
